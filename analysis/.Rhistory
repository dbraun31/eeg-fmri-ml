result <- d[!is.na(dmn),
.(cors = list(sapply(.SD, function(col) cor(dmn, col, use = 'pairwise.complete.obs')))),
by = .(subject, session, run),
.SDcols = voltage_cols
][
,
.(mean_cors = list(Reduce(`+`, cors) / length(cors))),
by = subject
]
head(result)
11000 * 25
length(sapply(result$mean_cors, FUN = function(x) unlist(x)))
l <- apply(result, MARGIN=0, FUN = function(x) list(rep(x$subject, length(subject=unlist(x$mean_cors))), mean_cors=unlist(mean_cors)))
l <- apply(result, MARGIN=0, FUN = function(x) list(subject = rep(x$subject, length(unlist(x$mean_cors))), mean_cors=unlist(mean_cors)))
result[, .(feature = voltage_cols, mean_correlation = unlist(mean_cors)), by = subject]
result <- d[!is.na(dmn),
.(cors = list(sapply(.SD, function(col) cor(dmn, col, use = 'pairwise.complete.obs')))),
by = .(subject, session, run),
.SDcols = voltage_cols
][
,
.(mean_cors = list(Reduce(`+`, cors) / length(cors))),
by = subject
][
,
.(feature = voltage_cols, mean_cors = unlist(mean_cors)),
by = subject
]
