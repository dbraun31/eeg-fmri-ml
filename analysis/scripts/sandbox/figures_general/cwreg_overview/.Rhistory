ggplot(aes(x = time, y = frequency, fill = power)) +
geom_raster(interpolate=TRUE) +
scale_y_log10() +
scale_fill_viridis_c(option = 'plasma', limits = c(0, max_p), breaks = seq(0, max_p, length.out=2)) +
