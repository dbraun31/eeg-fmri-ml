mutate(bin = cut(frequency, breaks, labels)) %>%
filter(bin %in% bands_grab,
network %in% !!networks) %>%
group_by(subject, bin, !!sym(y_var), network) %>%
summarize(cors = mean(cors)) %>%
group_by(bin, !!sym(y_var), network) %>%
summarize(cors = mean(cors)) %>%
