rm(list = ls())
library(tidyverse)
library(here)
library(fs)
args <- commandArgs(trailingOnly=TRUE)
if (length(args) == 0) {
setwd(here())
data_root <- path('analysis/data/original')
} else if (length(args) == 1) {
data_root <- path(args[1])
} else {
stop('Ambiguous input arguments.')
}
library(arrow)
d <- read_feather(path(data_root, '../correlation_data/correlations_long_bytask.feather'))
head(d)
nrow(d)
library(data.table)
# Import data
d <- data.table(read_feather(path(data_root, '../correlation_data/correlations_long_bytask.feather')))
# Fisher transform
d[, cors := fisherz(cors)]
library(psych)
# Fisher transform
d[, cors := fisherz(cors)]
head(d)
# Spread across task
d <- dcast(d, ... ~ task, value.var='cors')
head(d)
# Import data
d <- data.table(read_feather(path(data_root, '../correlation_data/correlations_long_bytask.feather')))
# Fisher transform
d[, cors := fisherz(cors)][, run := NULL]
# Spread across task
d <- dcast(d, ... ~ task, value.var='cors')
head(d)
# Import data
d <- data.table(read_feather(path(data_root, '../correlation_data/correlations_long_bytask.feather')))
head(d)
unique(d$run)
# Average across task & EEG feature
d <- d[, .(cors = mean(cors)), by = .(subject, session, channel, frequency, lag, task, network)]
nrow(d)
head(d)
# Fisher transform
d[, cors := fisherz(cors)]
# Spread across task
d <- dcast(d, ... ~ task, value.var='cors')
head(d)
# Summarize similarity across tasks for each subject & network
out <- d[, .(gradcpt_rest = cor(gradcpt, rest, method='spearman'),
gradcpt_tp = cor(gradcpt, tp, method = 'spearman'),
rest_tp = cor(rest, tp, method = 'spearman')),
by = .(subject, network)]
head(out)
t <- melt(out, id.vars = c('subject', 'network'),
measure.vars = c('gradcpt_rest', 'gradcpt_tp', 'rest_tp'),
variable.name = 'contrast',
value.name = 'similarity')
head(t)
nrow(out)
t[, .(m = mean(similarity), sd = sd(similarity)), by = contrast]
t[is.na(similarity)]
# Import data
d <- data.table(read_feather(path(data_root, '../correlation_data/correlations_long_bytask.feather')))
# Average across task & EEG feature
d <- d[, .(cors = mean(cors)), by = .(subject, session, channel, frequency, lag, task, network)]
# Fisher transform
d[, cors := fisherz(cors)]
# Yank subject 3
d <- d[subject != 'sub-003']
# Spread across task
d <- dcast(d, ... ~ task, value.var='cors')
# Summarize similarity across tasks for each subject & network
out <- d[, .(gradcpt_rest = cor(gradcpt, rest, method='spearman'),
gradcpt_tp = cor(gradcpt, tp, method = 'spearman'),
rest_tp = cor(rest, tp, method = 'spearman')),
by = .(subject, network)]
t <- melt(out, id.vars = c('subject', 'network'),
measure.vars = c('gradcpt_rest', 'gradcpt_tp', 'rest_tp'),
variable.name = 'contrast',
value.name = 'similarity')
t[, .(m = mean(similarity), sd = sd(similarity)), by = contrast]
group <- t[, .(m = mean(similarity), sd = sd(similarity)), by = contrast]
write.csv(out, path(data_root, 'task_similarity_subject_network.csv'), row.names=FALSE)
write.csv(group, path(data_root, 'task_similarity_group.csv'), row.names=FALSE)
write.csv(out, path(data_root, '../correlation_data/task_similarity_subject_network.csv'), row.names=FALSE)
write.csv(group, path(data_root, '../correlation_data/task_similarity_group.csv'), row.names=FALSE)
q()
